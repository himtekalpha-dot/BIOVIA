rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isEmailVerified() && request.auth.uid == userId;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'xp', 'level', 'completedCount', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'xp', 'level', 'completedCount', 'dailyChallengeBestScore', 'createdAt', 'updatedAt'])
        && data.uid == userId
        && isValidId(data.uid)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100
        && data.xp is int && data.xp >= 0 && data.xp <= 1000000
        && data.level is int && data.level >= 1 && data.level <= 100
        && data.completedCount is int && data.completedCount >= 0 && data.completedCount <= 24
        && (!('dailyChallengeBestScore' in data) || (data.dailyChallengeBestScore is int && data.dailyChallengeBestScore >= 0 && data.dailyChallengeBestScore <= 100))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserPrivateInfo(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'photoUrl', 'createdAt', 'updatedAt'])
        && data.uid == userId
        && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 512))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMaterialProgress(data, userId, materialSlug) {
      return data.keys().hasAll(['userId', 'materialSlug', 'title', 'category', 'bestScore', 'lastScore', 'attempts', 'completed', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'materialSlug', 'title', 'category', 'bestScore', 'lastScore', 'attempts', 'completed', 'createdAt', 'updatedAt'])
        && data.userId == userId
        && isValidId(data.userId)
        && data.materialSlug == materialSlug
        && isValidId(data.materialSlug)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && data.category in ['manusia', 'hewan', 'tumbuhan', 'sel']
        && data.bestScore is int && data.bestScore >= 0 && data.bestScore <= 100
        && data.lastScore is int && data.lastScore >= 0 && data.lastScore <= 100
        && data.attempts is int && data.attempts >= 1 && data.attempts <= 10000
        && data.completed is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidQuizAttempt(data, userId) {
      return data.keys().hasAll(['userId', 'materialSlug', 'materialTitle', 'score', 'correctCount', 'totalQuestions', 'createdAt'])
        && data.keys().hasOnly(['userId', 'materialSlug', 'materialTitle', 'score', 'correctCount', 'totalQuestions', 'createdAt'])
        && data.userId == userId
        && isValidId(data.userId)
        && isValidId(data.materialSlug)
        && data.materialTitle is string && data.materialTitle.size() >= 1 && data.materialTitle.size() <= 160
        && data.score is int && data.score >= 0 && data.score <= 100
        && data.totalQuestions is int && data.totalQuestions >= 1 && data.totalQuestions <= 50
        && data.correctCount is int && data.correctCount >= 0 && data.correctCount <= data.totalQuestions
        && data.createdAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'xp', 'level', 'completedCount', 'dailyChallengeBestScore', 'updatedAt']);
      allow delete: if false;

      match /private/{infoId} {
        allow get: if isValidId(userId) && infoId == 'info' && isOwner(userId);
        allow list: if false;
        allow create: if isValidId(userId)
          && infoId == 'info'
          && isOwner(userId)
          && isValidUserPrivateInfo(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId)
          && infoId == 'info'
          && isOwner(userId)
          && isValidUserPrivateInfo(incoming(), userId)
          && incoming().uid == existing().uid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'photoUrl', 'updatedAt']);
        allow delete: if false;
      }

      match /materialProgress/{materialSlug} {
        allow get: if isValidId(userId) && isValidId(materialSlug) && isOwner(userId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(materialSlug)
          && isOwner(userId)
          && isValidMaterialProgress(incoming(), userId, materialSlug)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && (
            exists(/databases/$(database)/documents/users/$(userId)) ||
            existsAfter(/databases/$(database)/documents/users/$(userId))
          );
        allow update: if isValidId(userId)
          && isValidId(materialSlug)
          && isOwner(userId)
          && isValidMaterialProgress(incoming(), userId, materialSlug)
          && incoming().userId == existing().userId
          && incoming().materialSlug == existing().materialSlug
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['bestScore', 'lastScore', 'attempts', 'completed', 'updatedAt']);
        allow delete: if false;
      }

      match /quizHistory/{attemptId} {
        allow get: if isValidId(userId) && isValidId(attemptId) && isOwner(userId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(attemptId)
          && isOwner(userId)
          && isValidQuizAttempt(incoming(), userId)
          && incoming().createdAt == request.time
          && (
            exists(/databases/$(database)/documents/users/$(userId)) ||
            existsAfter(/databases/$(database)/documents/users/$(userId))
          );
        allow update, delete: if false;
      }
    }
  }
}
